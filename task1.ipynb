        "def extract_domain(publisher_name):\n",
        "    if '@' in str(publisher_name):\n",
        "        return str(publisher_name).split('@')[-1]\n",
        "    return None\n",
        "\n",
        "df['publisher_domain'] = df['publisher'].apply(extract_domain)\n",
        "\n",
        "unique_domains = df['publisher_domain'].dropna().value_counts()\n",
        "\n",
        "print(\"Unique Domains Extracted from Publisher Email Addresses:\")\n",
        "display(unique_domains.head(10))"
